# Copy to .env (or set these in your shell / Colab Secrets). Never commit real keys.

# Required: OpenRouter API key for all LLM calls. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: LangSmith tracing (rubric section 8). If unset, the notebook runs with tracing off.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-personal-assistant
